{
  "name": "@aiwayds/dsh-topics-memory",
  "version": "0.11.0",
  "description": "dsh-plugin: quality-first topic memory for dsh — a topic keeps the starting question, conclusion, impact and dependencies, not the process; local-first git-traced OKF bundle, budgeted LLM-free injection",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "plugin",
    "topic-memory",
    "okf",
    "open-knowledge-format",
    "memory",
    "topic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fan56/dsh-topics-memory.git"
  },
  "homepage": "https://github.com/fan56/dsh-topics-memory",
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "pretest": "tsc -p tsconfig.json",
